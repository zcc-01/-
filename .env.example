# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，禁止提交真实密钥
APP_ENV=dev
LOG_LEVEL=INFO

# 开发用 SQLite（默认即可）；生产切 MySQL：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/agritrace?charset=utf8mb4
DATABASE_URL=sqlite:///data/app.db

# JWT 密钥：生产必须替换为随机 32 字节以上字符串
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRE_MINUTES=120

# 哈希链
GENESIS_SALT=GENESIS
CHAIN_PAGE_SIZE=500
CHAIN_MAX_RETRY=5

# 赋码上限
MAX_CODE_BATCH=5000

# 交易域：未支付订单自动取消时限（分钟）与支付失败重试上限
ORDER_PAY_TIMEOUT_MINUTES=30
ORDER_MAX_PAY_ATTEMPTS=3
# 模拟支付网关强制失败开关（演示支付失败分支时设为 1）
# MOCKPAY_FORCE_FAIL=0

# 演示用免密登录开关，生产必须置为 false
DEV_MODE=true

# 多进程部署时每个 worker 给不同的 WORKER_ID（0~31）
WORKER_ID=1
