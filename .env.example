# 复制为 .env 后按需修改；所有项都有代码内默认值，不配也能跑
APP_ENV=dev
LOG_LEVEL=INFO

# 数据库：默认 SQLite 文件库；切 MySQL 只需改这一行
DATABASE_URL=sqlite:///./data/app.db

# 鉴权：生产环境务必替换为随机值（python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRE_MINUTES=120
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15

# 验证码
SMS_CODE_TTL_SECONDS=300

# 产地认证
CERT_VALID_MONTHS=12
CERT_REMIND_DAYS=30
CERT_REVIEW_SLA_DAYS=3
TEST_REPORT_VALID_MONTHS=12

# 预警
ALERT_ENABLE_SCHEDULER=true
ALERT_SCAN_MINUTES=30
ALERT_NO_LOGISTICS_DAYS=7
ALERT_CROSS_PROVINCE=3
ALERT_CROSS_HOURS=24

# 开发便利开关：生产必须设为 false
DEV_MODE=true
